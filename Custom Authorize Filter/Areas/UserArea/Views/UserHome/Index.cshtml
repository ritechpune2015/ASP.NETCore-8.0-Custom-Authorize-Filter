@model IEnumerable<Product>
<!DOCTYPE html>
    <html>
    <head>
        <title></title>
    </head>
    <body>
       <h2> Product List </h2>
       <table>
           <thead>
               <tr>
                   <th> Product ID </th>
                   <th> Product Name </th>
                   <th> Mfg Name </th>
                   <th> Price </th>
               </tr>
           </thead>
        @foreach (var temp in Model)
        {
           <tr>
               <td> @temp.ProductID </td>
               <td> @temp.ProductName</td>
               <td>@temp.MfgName</td>
               <td>@temp.Price</td>
           </tr>  
        }
    </table>

    </body>
    </html>